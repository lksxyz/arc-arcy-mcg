# Target network: "testnet" (default) or "mainnet"
VITE_NETWORK=testnet

# Mainnet contract addresses, required only when VITE_NETWORK=mainnet
VITE_REGISTRY_MAINNET=
VITE_ANNOUNCER_MAINNET=
VITE_PAY_MAINNET=

# Optional Arc Studio RPC proxy, injected automatically inside Arc Studio
RPC_PROXY_BASE_URL=
RPC_PROXY_TOKEN=
RPC_PROXY_CHAINS=
